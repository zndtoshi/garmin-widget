GARMIN_WIDGET_APP_ENV=local
GARMIN_WIDGET_SERVICE_NAME=garmin-widget-backend
GARMIN_WIDGET_APP_VERSION=0.1.0
GARMIN_WIDGET_LOG_LEVEL=INFO
GARMIN_WIDGET_DATA_DIR=./data
GARMIN_WIDGET_REFRESH_COOLDOWN_SECONDS=60
# IANA timezone used only to choose the Garmin calendar date (timestamps stay UTC).
GARMIN_WIDGET_TIMEZONE=Europe/Bucharest
# Required for /api/v1/widget/* and for production. Leave commented until you generate a real token.
# Generate locally (do not commit the result):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then set only in ignored .env / Render secrets / Android secure storage later:
# GARMIN_WIDGET_WIDGET_BEARER_TOKEN=your-generated-token-here
# Optional Garmin bootstrap credentials (omit unless testing Garmin auth locally):
# GARMIN_WIDGET_GARMIN_USERNAME=your-garmin-username
# GARMIN_WIDGET_GARMIN_PASSWORD=your-garmin-password
